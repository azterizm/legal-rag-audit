# Nothing here reaches the image.

# Excluded from the image by policy, not by accident.
# See internal_experiments/README.md and V2_FULL_PLAN.md §4.2.
internal_experiments/

# VCS and local state
.git/
.gitignore

# CI definitions and the release signing key. Both are public and neither is harmful in
# a layer, but neither does anything inside one either — and the smallest image that
# still works is the one a reviewer can finish reading.
.github/
.venv/
venv/
env/
ENV/

# Build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Local secrets and run output — must never be baked into a layer
.env
config.yaml
reports/
*.log

# Planning documents, not shipped
V1_PLAN.md
V2_FULL_PLAN.md
V2_PROGRESS.md

# Scratch
scratch_json.py
check_nli.py
