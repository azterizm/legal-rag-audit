{
  "$defs": {
    "BatteryComposition": {
      "additionalProperties": false,
      "description": "What was asked, declared before the run (\u00a73.5, F39).",
      "properties": {
        "eligible_by_check": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Eligible By Check",
          "type": "object"
        },
        "no_correct_answer_probes": {
          "title": "No Correct Answer Probes",
          "type": "integer"
        },
        "positive_probes": {
          "title": "Positive Probes",
          "type": "integer"
        },
        "total_probes": {
          "title": "Total Probes",
          "type": "integer"
        }
      },
      "required": [
        "total_probes",
        "positive_probes",
        "no_correct_answer_probes"
      ],
      "title": "BatteryComposition",
      "type": "object"
    },
    "Capture": {
      "additionalProperties": false,
      "description": "What the response file carried, which decides what could be checked at all.",
      "properties": {
        "citations_captured": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citations Captured"
        },
        "document_ids_supplied": {
          "title": "Document Ids Supplied",
          "type": "boolean"
        },
        "eligibility_source": {
          "title": "Eligibility Source",
          "type": "string"
        },
        "passes": {
          "title": "Passes",
          "type": "integer"
        },
        "records": {
          "title": "Records",
          "type": "integer"
        },
        "retrieved_chunks_captured": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved Chunks Captured"
        },
        "transport_errors": {
          "title": "Transport Errors",
          "type": "integer"
        }
      },
      "required": [
        "eligibility_source",
        "document_ids_supplied",
        "passes",
        "records",
        "transport_errors"
      ],
      "title": "Capture",
      "type": "object"
    },
    "CaptureSummary": {
      "additionalProperties": false,
      "description": "What the response file did not carry, and which checks that disabled.",
      "properties": {
        "checks_not_run": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Checks Not Run",
          "type": "object"
        },
        "citations_captured": {
          "title": "Citations Captured",
          "type": "boolean"
        },
        "document_ids_supplied": {
          "title": "Document Ids Supplied",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "probes_asked_verbatim": {
          "default": 0,
          "title": "Probes Asked Verbatim",
          "type": "integer"
        },
        "probes_asked_wrapped": {
          "items": {
            "type": "string"
          },
          "title": "Probes Asked Wrapped",
          "type": "array"
        },
        "records": {
          "title": "Records",
          "type": "integer"
        },
        "retrieved_chunks_captured": {
          "title": "Retrieved Chunks Captured",
          "type": "boolean"
        },
        "transport_errors": {
          "title": "Transport Errors",
          "type": "integer"
        }
      },
      "required": [
        "records",
        "transport_errors",
        "citations_captured",
        "retrieved_chunks_captured",
        "document_ids_supplied"
      ],
      "title": "CaptureSummary",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "What one registered check concluded, or why it did not conclude anything.",
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "cross_cutting": {
          "default": false,
          "title": "Cross Cutting",
          "type": "boolean"
        },
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "distribution": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "eligible": {
          "title": "Eligible",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "failed_all_passes": {
          "default": 0,
          "title": "Failed All Passes",
          "type": "integer"
        },
        "failed_some_passes": {
          "default": 0,
          "title": "Failed Some Passes",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "measurement": {
          "default": false,
          "title": "Measurement",
          "type": "boolean"
        },
        "not_captured": {
          "title": "Not Captured",
          "type": "integer"
        },
        "partial": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "recipe": {
          "title": "Recipe",
          "type": "string"
        },
        "scored": {
          "title": "Scored",
          "type": "integer"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_ELIGIBLE",
            "NOT_CAPTURED"
          ],
          "title": "Status",
          "type": "string"
        },
        "tier": {
          "title": "Tier",
          "type": "integer"
        }
      },
      "required": [
        "check",
        "tier",
        "key",
        "recipe",
        "eligible",
        "scored",
        "not_captured",
        "failed",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "EvidenceIndex": {
      "additionalProperties": false,
      "description": "Where the verbatim material for one check's findings was written (F41).",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "instances": {
          "title": "Instances",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "instances"
      ],
      "title": "EvidenceIndex",
      "type": "object"
    },
    "InputDigests": {
      "additionalProperties": false,
      "description": "The bytes this run was computed from.",
      "properties": {
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        },
        "corpus_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Hash"
        },
        "corpus_hash_provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Hash Provenance"
        },
        "ground_truth_manifest_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ground Truth Manifest Hash"
        },
        "query_set_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Set Hash"
        },
        "recipes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Recipes",
          "type": "object"
        },
        "responses_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Responses Hash"
        }
      },
      "title": "InputDigests",
      "type": "object"
    },
    "InstrumentRecord": {
      "additionalProperties": false,
      "description": "One model in the scoring path, and the line it was read against.",
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "library": {
          "title": "Library",
          "type": "string"
        },
        "library_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library Version"
        },
        "library_version_unavailable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library Version Unavailable"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "threshold_kind": {
          "title": "Threshold Kind",
          "type": "string"
        },
        "threshold_source": {
          "title": "Threshold Source",
          "type": "string"
        },
        "weights_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Revision"
        },
        "weights_revision_unavailable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Revision Unavailable"
        }
      },
      "required": [
        "check",
        "role",
        "model",
        "library",
        "threshold",
        "threshold_source",
        "threshold_kind"
      ],
      "title": "InstrumentRecord",
      "type": "object"
    },
    "PreCommitment": {
      "additionalProperties": false,
      "description": "Whether the answer key was fixed before the responses existed (\u00a73.6).",
      "properties": {
        "carried": {
          "items": {
            "type": "string"
          },
          "title": "Carried",
          "type": "array"
        },
        "created": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created"
        },
        "handover_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handover Record"
        },
        "status": {
          "enum": [
            "verified",
            "absent"
          ],
          "title": "Status",
          "type": "string"
        },
        "verified": {
          "items": {
            "type": "string"
          },
          "title": "Verified",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "PreCommitment",
      "type": "object"
    },
    "RunFacts": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus"
        },
        "corpus_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Digest"
        },
        "corpus_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Mode"
        },
        "eligibility_source": {
          "title": "Eligibility Source",
          "type": "string"
        },
        "finished": {
          "title": "Finished",
          "type": "string"
        },
        "passes": {
          "title": "Passes",
          "type": "integer"
        },
        "plants": {
          "default": 0,
          "title": "Plants",
          "type": "integer"
        },
        "remote_scoring": {
          "default": false,
          "title": "Remote Scoring",
          "type": "boolean"
        },
        "seed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "seed_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Source"
        },
        "staleness_triggers": {
          "items": {
            "type": "string"
          },
          "title": "Staleness Triggers",
          "type": "array"
        },
        "started": {
          "title": "Started",
          "type": "string"
        }
      },
      "required": [
        "started",
        "finished",
        "passes",
        "eligibility_source"
      ],
      "title": "RunFacts",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "properties": {
        "authorisation": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorisation"
        },
        "battery": {
          "$ref": "#/$defs/BatteryComposition"
        },
        "capture": {
          "$ref": "#/$defs/CaptureSummary"
        },
        "inputs": {
          "$ref": "#/$defs/InputDigests"
        },
        "not_recorded": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Not Recorded",
          "type": "object"
        },
        "pre_commitment": {
          "$ref": "#/$defs/PreCommitment"
        },
        "run": {
          "$ref": "#/$defs/RunFacts"
        },
        "schema": {
          "const": "run_manifest.v1",
          "default": "run_manifest.v1",
          "title": "Schema",
          "type": "string"
        },
        "scoring": {
          "$ref": "#/$defs/ScoringFacts"
        },
        "tool": {
          "$ref": "#/$defs/ToolProvenance"
        }
      },
      "required": [
        "tool",
        "inputs",
        "pre_commitment",
        "run",
        "scoring",
        "battery",
        "capture"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "ScoringFacts": {
      "additionalProperties": false,
      "properties": {
        "checks_registered": {
          "title": "Checks Registered",
          "type": "integer"
        },
        "findings_hash": {
          "title": "Findings Hash",
          "type": "string"
        },
        "findings_hash_recipe": {
          "title": "Findings Hash Recipe",
          "type": "string"
        },
        "instruments": {
          "items": {
            "$ref": "#/$defs/InstrumentRecord"
          },
          "title": "Instruments",
          "type": "array"
        },
        "tier2_skipped": {
          "title": "Tier2 Skipped",
          "type": "boolean"
        }
      },
      "required": [
        "checks_registered",
        "tier2_skipped",
        "findings_hash",
        "findings_hash_recipe"
      ],
      "title": "ScoringFacts",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Counts, never a rate (\u00a73.5, Appendix D).",
      "properties": {
        "checks_registered": {
          "title": "Checks Registered",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "measurements": {
          "items": {
            "type": "string"
          },
          "title": "Measurements",
          "type": "array"
        },
        "not_captured": {
          "title": "Not Captured",
          "type": "integer"
        },
        "not_eligible": {
          "title": "Not Eligible",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "published_keys": {
          "title": "Published Keys",
          "type": "integer"
        },
        "tier1_findings": {
          "items": {
            "type": "string"
          },
          "title": "Tier1 Findings",
          "type": "array"
        },
        "tier2_findings": {
          "items": {
            "type": "string"
          },
          "title": "Tier2 Findings",
          "type": "array"
        },
        "variance": {
          "additionalProperties": true,
          "title": "Variance",
          "type": "object"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "withheld_keys": {
          "title": "Withheld Keys",
          "type": "integer"
        }
      },
      "required": [
        "checks_registered",
        "passed",
        "failed",
        "not_eligible",
        "not_captured",
        "published_keys",
        "withheld_keys",
        "verdict"
      ],
      "title": "Summary",
      "type": "object"
    },
    "ToolProvenance": {
      "additionalProperties": false,
      "description": "Which build produced the report.",
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "commit_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Signature"
        },
        "commit_signature_verify_with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Signature Verify With"
        },
        "commit_unavailable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Unavailable"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "working_tree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Tree"
        }
      },
      "required": [
        "version"
      ],
      "title": "ToolProvenance",
      "type": "object"
    }
  },
  "$id": "https://github.com/legal-rag-audit/schemas/report.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture": {
      "$ref": "#/$defs/Capture"
    },
    "checks": {
      "additionalProperties": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceIndex"
      },
      "title": "Evidence",
      "type": "object"
    },
    "manifest": {
      "$ref": "#/$defs/RunManifest"
    },
    "schema": {
      "const": "report.v2",
      "default": "report.v2",
      "title": "Schema",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tier1": {
      "items": {
        "type": "string"
      },
      "title": "Tier1",
      "type": "array"
    },
    "tier2": {
      "items": {
        "type": "string"
      },
      "title": "Tier2",
      "type": "array"
    }
  },
  "required": [
    "schema",
    "manifest",
    "checks",
    "summary",
    "capture"
  ],
  "title": "Report (JSON) \u2014 the evidence; report.md is the testimony",
  "type": "object"
}
