{
  "$defs": {
    "Adjacency": {
      "additionalProperties": false,
      "description": "A fact and its identifier must appear within the same unit of text.\n\nAn answer that states the right figure in one paragraph and the right document ID\nthree paragraphs later has not attributed the figure to the document \u2014 it has\nmentioned both. \u00a78.2 scores adjacency by sentence unit for exactly that reason.",
      "properties": {
        "fact": {
          "title": "Fact",
          "type": "string"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "unit": {
          "default": "sentence",
          "enum": [
            "sentence",
            "paragraph"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "fact",
        "identifier"
      ],
      "title": "Adjacency",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "description": "What one check expects of one probe's answer.",
      "properties": {
        "adjacency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Adjacency"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "legacy_params": {
          "additionalProperties": true,
          "title": "Legacy Params",
          "type": "object"
        },
        "must_cite_any_of": {
          "items": {
            "type": "string"
          },
          "title": "Must Cite Any Of",
          "type": "array"
        },
        "must_contain": {
          "items": {
            "type": "string"
          },
          "title": "Must Contain",
          "type": "array"
        },
        "must_not_contain": {
          "items": {
            "type": "string"
          },
          "title": "Must Not Contain",
          "type": "array"
        },
        "probe_id": {
          "title": "Probe Id",
          "type": "string"
        },
        "queried_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queried As"
        }
      },
      "required": [
        "probe_id",
        "check"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "Plant": {
      "additionalProperties": false,
      "description": "One seeded invariant and where it was inserted. Phase D populates this.",
      "properties": {
        "companions": {
          "items": {
            "type": "string"
          },
          "title": "Companions",
          "type": "array"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "plant_id": {
          "title": "Plant Id",
          "type": "string"
        },
        "tenant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "plant_id",
        "type",
        "value",
        "document"
      ],
      "title": "Plant",
      "type": "object"
    }
  },
  "$id": "https://github.com/legal-rag-audit/schemas/ground_truth.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The manifest as a whole.",
  "properties": {
    "expectations": {
      "items": {
        "$ref": "#/$defs/Expectation"
      },
      "title": "Expectations",
      "type": "array"
    },
    "plants": {
      "items": {
        "$ref": "#/$defs/Plant"
      },
      "title": "Plants",
      "type": "array"
    },
    "schema": {
      "const": "ground_truth.v1",
      "default": "ground_truth.v1",
      "title": "Schema",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "schema",
    "expectations"
  ],
  "title": "Ground-truth manifest (JSON) \u2014 withheld, hashed at handover",
  "type": "object"
}
